# Utility Provider Credentials
# Add your utility provider credentials here
# Example format:
# PROVIDER_USERNAME=your_username
# PROVIDER_PASSWORD=your_password

# AppFolio Credentials
APPFOLIO_API_KEY=your_appfolio_api_key
APPFOLIO_CLIENT_ID=your_client_id
APPFOLIO_CLIENT_SECRET=your_client_secret
APPFOLIO_BASE_URL=https://api.appfolio.com

# Download Settings
DOWNLOAD_PATH=./downloaded_bills
CURRENT_BILLING_PERIOD_MONTHS=3  # How many months back to download

# Logging
LOG_LEVEL=INFO
